# .env.template
# Copied to .env on EC2 #1 by scripts/install-coolify.sh.tftpl (rendered by
# Terraform), which fills in every __PLACEHOLDER__ from AWS Secrets Manager
# at boot time. NEVER commit a filled-in .env to this repository.

APP_NAME=Coolify
APP_ENV=production
APP_KEY=__APP_KEY__
# APP_URL is set to the Control Plane's own address for now. Once the
# production domain is decided, update it from the Dashboard itself
# (Settings -> General -> URL) - no redeploy needed for that change.
APP_URL=http://__CONTROL_PLANE_PUBLIC_IP__:8080

# --- Database: Amazon RDS PostgreSQL (replaces the coolify-db container) ---
DB_CONNECTION=pgsql
DB_HOST=__RDS_ENDPOINT__
DB_PORT=5432
DB_DATABASE=coolify
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=__DB_PASSWORD__

# --- Queue/cache: Amazon ElastiCache Redis (replaces the coolify-redis container) ---
# No AUTH token: AWS requires transit encryption for AUTH to work, and this
# stack's Redis client doesn't support TLS - so both are disabled together.
# Access is restricted entirely by the Security Group (Control Plane only).
REDIS_HOST=__ELASTICACHE_ENDPOINT__
REDIS_PORT=6379
REDIS_PASSWORD=

# --- First admin user ---
# Intentionally left unset. Coolify shows its own registration screen on
# first visit when no user exists yet - the admin creates the account
# manually and keeps the credentials privately.

# --- ECR image source (used by docker-compose.yml, not by Coolify itself) ---
ECR_REGISTRY=__ACCOUNT_ID__.dkr.ecr.__AWS_REGION__.amazonaws.com
COOLIFY_VERSION=__COOLIFY_VERSION__
REALTIME_VERSION=__REALTIME_VERSION__
TRAEFIK_VERSION=__TRAEFIK_VERSION__
