# terraform.tfvars.example
#
# Copy this file to terraform.tfvars (which is gitignored) and fill in your
# own values. terraform.tfvars is only used for local runs (`terraform plan`
# from your own machine) - the actual pipeline reads the required values
# from CodeBuild environment variables instead (see README.md).

# --- Required, no default ---
account_id     = "123456789012"     # your AWS account ID
admin_ssh_cidr = "203.0.113.4/32"   # your own IP, for SSH + initial dashboard access
tag_owner      = "you@example.com"  # whoever is responsible for these resources

# --- Optional overrides (sensible defaults already exist in variables.tf) ---
# aws_region                  = "us-east-1"
# tag_product                 = "coolify"
# tag_environment             = "production"
# control_plane_instance_type = "t3.medium"
# runtime_instance_type       = "t3.medium"
# runtime_server_names        = ["runtime-2", "runtime-3"]
# db_instance_class           = "db.t3.small"
# cache_node_type              = "cache.t3.micro"
#
# coolify_versions = {
#   coolify  = "4.3.19"
#   realtime = "1.0.17"
#   sentinel = "0.0.22"
#   traefik  = "v3.6"
# }
